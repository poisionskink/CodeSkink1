# LifeLine Navigator - Environment Variables
# Copy this to .env and fill in your values

# OpenRouteService API (free tier: 2000 req/day) - for routing
# Get key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_ors_api_key_here

# OpenWeatherMap API (free tier) - for weather/hazard data
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Twilio (optional) - for SMS alerts
# Get credentials at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# App Settings
APP_ENV=development
DEBUG=true
DEFAULT_CITY=amritsar
OFFLINE_MODE=true